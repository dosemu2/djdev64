#
# spec file for package dj64dev
#

Name: djdev64
Version: {{{ git_dir_version }}}
Release: 1%{?dist}
Summary: 64-bit djgpp-compatible dev suite

Group: Development/Libraries

License: GPLv3+
URL: https://github.com/dosemu2/djdev64
VCS: {{{ git_dir_vcs }}}
Source0: {{{ git_dir_archive }}}

BuildRequires: meson
BuildRequires: ninja-build
BuildRequires: gcc
BuildRequires: binutils
BuildRequires: elfutils-libelf-devel
BuildRequires: pkgconf-pkg-config

%description
SDK for working with dj64-based executables
%end

%prep
{{{ git_dir_setup_macro }}}
%end

%build
%meson
%meson_build
%end

%check
%end

%install
%meson_install
%end


%files
%defattr(-,root,root)
%{_libdir}/*.so.*
%end

%package devel
Summary: djdev64 development libraries and headers
Requires: djdev64 = {{{ git_dir_version }}}

%description devel
This package contains development libraries and headers for
djdev64-enabled DPMI host.
%end

%files devel
%defattr(-,root,root)
%{_includedir}/djdev64
%{_libdir}/*.so
%{_libdir}/pkgconfig/djdev64.pc
%{_libdir}/pkgconfig/djstub64.pc
%end

%changelog
{{{ git_dir_changelog }}}
%end
